[workernodes]
# Replace worker_node_ip with the actual IP address or DNS name of your Worker Node
worker_node_ip ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/id_rsa ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[workernodes:vars]
# Custom docker network specified in requirements
custom_network=devops_network
# Ports configuration
app_port=8085
db_port=3306
